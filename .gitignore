# Environment variables / secrets
#
# Nada de credencial no repositorio: as credenciais AWS vem do ambiente
# (aws configure / variaveis de ambiente), nunca de um arquivo versionado.

.env
.env.*
!.env.example

# AWS

.aws/

# Terraform
#
# O state guarda ARNs, IDs de conta e atributos de recurso — nao vai para o Git.
# Os tfvars podem conter valores especificos do ambiente de quem aplica.

.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Pacotes da Lambda gerados pelo archive_file

*.zip

# Logs

*.log
logs/
